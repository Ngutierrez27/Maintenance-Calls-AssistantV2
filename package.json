{
  "name": "maintenance-call-assistantv2",
  "version": "1.0.9",
  "description": "Temporary call-logging app",
  "main": "main.js",
  "author": "Noel Gutierrez",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "appId": "com.example.maintenancecalls",
    "productName": "Maintenance Call Assistant",
    "mac": {
      "icon": "assets/icons/mac/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icons/win/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Ngutierrez27",
        "repo": "Maintenance-Calls-AssistantV2",
        "releaseType": "release"
      }
    ]
  }
}
